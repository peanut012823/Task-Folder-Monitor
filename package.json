{
  "name": "task-folder-monitor",
  "version": "1.0.0",
  "description": "Local desktop task and folder monitoring app",
  "main": "electron/main.cjs",
  "author": "Task Folder Monitor",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "start": "electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "pack": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.2",
    "electron": "^38.1.0",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.taskfoldermonitor.app",
    "productName": "Task Folder Monitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Task Folder Monitor"
    }
  }
}
